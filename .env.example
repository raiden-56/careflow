# Copy to .env and adjust. Values here are DEVELOPMENT defaults only.
POSTGRES_DB=careflow
POSTGRES_USER=careflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5440

# Backend
DB_URL=jdbc:postgresql://localhost:5440/careflow
DB_USERNAME=careflow
DB_PASSWORD=change-me
# At least 32 random bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-bytes
# true when served over HTTPS (required in production)
COOKIE_SECURE=false
FRONTEND_BASE_URL=http://localhost:3000
# Initial platform super administrator (created on first start if missing)
CAREFLOW_SUPERADMIN_EMAIL=superadmin@careflow.local
CAREFLOW_SUPERADMIN_PASSWORD=
# Development only: seed the fictional demo hospital / expose the dev email outbox
DEMO_SEED=false
DEV_OUTBOX=false
UPLOAD_DIR=./uploads

# Frontend (Next.js server-side rewrite target)
BACKEND_URL=http://localhost:8080
